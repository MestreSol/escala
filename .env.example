# String de conexão do Postgres (ex: Supabase). Em Supabase: Project Settings
# > Database > Connection string > URI. Se usar o pooler (porta 6543) em
# produção, adicione também DIRECT_URL com a conexão direta (porta 5432) e
# `directUrl = env("DIRECT_URL")` no datasource do schema.prisma.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# Login do administrador
ADMIN_USERNAME="admin"
# Gere com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
# IMPORTANTE: o Next.js expande $VAR dentro do .env, então troque cada "$" do
# hash gerado por "\$" antes de colar aqui (senão o valor fica corrompido).
ADMIN_PASSWORD_HASH=""
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
