# String de conexão do Postgres (ex: Supabase). Em Supabase: Project Settings
# > Database > Connection string > URI. Se usar o pooler (porta 6543) em
# produção, adicione também DIRECT_URL com a conexão direta (porta 5432) e
# `directUrl = env("DIRECT_URL")` no datasource do schema.prisma.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres"

# Assina o cookie de sessão do login. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Login agora é por conta real (tabela Usuario), não mais por env var. Depois
# de rodar as migrations, crie o primeiro administrador com:
# npm run criar-usuario -- <usuario> <senha> ADMIN
# (esse comando também precisa de SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY,
# usados por lib/supabase.ts — configure-os aqui também.)
