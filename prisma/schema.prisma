// Prisma schema — Escala de Servidores do Altar

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

/// ADMIN cadastra e remove outros usuários (da paróquia toda, ou só da própria
/// pastoral se tiver uma); OPERADOR usa o painel normalmente (calendário,
/// presença, servidores etc.) sem acesso à tela de usuários. SUPERADMIN não
/// pertence a nenhuma paróquia: cadastra as paróquias e escolhe em qual delas
/// está trabalhando no painel. PRESENCA só vê as missas do dia da própria
/// pastoral e registra quem compareceu (ver /admin/presenca).
enum PapelUsuario {
  ADMIN
  OPERADOR
  SUPERADMIN
  PRESENCA
}

/// Tenant: cada paróquia/grupo enxerga só os próprios dados. Toda tabela
/// "raiz" (Funcao, Missa, Servidor, Usuario, Escala, EscalaPublicada) e
/// MissaOcorrencia têm `paroquiaId`; as demais herdam pela FK do pai. O
/// filtro é feito no código (o app usa a chave service_role, que ignora RLS)
/// — ver lib/sessao.ts (painel) e lib/paroquia.ts (páginas públicas).
/// Dentro da paróquia, cada Pastoral é isolada de novo (ver Pastoral).
model Paroquia {
  id        String   @id @default(cuid())
  nome      String
  /// Primeiro segmento da URL das páginas públicas (ex: /matriz/escala).
  slug      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pastorais         Pastoral[]
  usuarios          Usuario[]
  funcoes           Funcao[]
  missas            Missa[]
  servidores        Servidor[]
  ocorrencias       MissaOcorrencia[]
  escalas           Escala[]
  escalasPublicadas EscalaPublicada[]
}

/// COROINHAS usa a hierarquia de Grau; MINISTROS é nível único (todo
/// servidor fica com o grau mais baixo e toda função exige só ele).
enum TipoPastoral {
  COROINHAS
  MINISTROS
}

/// Grupo que serve nas missas da paróquia (ex: coroinhas, ministros). Cada
/// pastoral só vê e escala os próprios servidores e funções: Funcao, Servidor,
/// Usuario, Escala, EscalaPublicada e EscalaAtribuicao têm `pastoralId`. As
/// missas (horários) e ocorrências são da paróquia, compartilhadas — o que
/// muda por pastoral numa missa fica em MissaPastoral e nas funções exigidas.
model Pastoral {
  id         String       @id @default(cuid())
  paroquiaId String
  nome       String
  /// Segundo segmento da URL pública (ex: /matriz/coroinhas/escala).
  slug       String
  tipo       TipoPastoral
  ativo      Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  paroquia          Paroquia           @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)
  usuarios          Usuario[]
  funcoes           Funcao[]
  servidores        Servidor[]
  missasConfig      MissaPastoral[]
  escalas           Escala[]
  escalasPublicadas EscalaPublicada[]
  atribuicoes       EscalaAtribuicao[]
  paresDeFuncoes    FuncaoPar[]

  @@unique([paroquiaId, slug])
}

model Usuario {
  id           String       @id @default(cuid())
  /// Nulo só para SUPERADMIN.
  paroquiaId   String?
  /// Nulo = paróquia toda: escolhe a pastoral em que trabalha no painel.
  pastoralId   String?
  /// Único no sistema todo: o login não pergunta a paróquia.
  username     String       @unique
  passwordHash String
  papel        PapelUsuario @default(OPERADOR)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  paroquia Paroquia? @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)
  pastoral Pastoral? @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@index([paroquiaId])
  @@index([pastoralId])
}

/// Grau/hierarquia do servidor. Quem tem um grau mais alto pode exercer as
/// funções dos graus abaixo (Cerimoniário faz tudo que Acólito e Coroinha
/// fazem; Acólito faz tudo que Coroinha faz). Ordem: COROINHA < ACOLITO <
/// CERIMONIARIO.
enum Grau {
  COROINHA
  ACOLITO
  CERIMONIARIO
}

model Funcao {
  id                 String     @id @default(cuid())
  paroquiaId         String
  pastoralId         String
  nome               String
  prioridade         Prioridade
  /// Grau mínimo exigido para exercer essa função (quem tem grau maior também pode).
  grauMinimo         Grau
  /// Quantidade padrão de vagas dessa função por missa (ex: Ceroferário = 2).
  /// Usada como valor inicial ao configurar os requisitos de cada missa;
  /// cada missa pode ajustar sua própria quantidade individualmente.
  quantidadePadrao   Int        @default(1)
  /// Se true, todas as vagas dessa função numa missa só são preenchidas se
  /// houver gente para TODAS ao mesmo tempo; senão, todas ficam em aberto
  /// (ex: Ceroferário sempre anda em dupla, não faz sentido só 1 dos 2).
  exigeGrupoCompleto Boolean    @default(false)
  ativo              Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  missasRequisito MissaFuncaoRequisito[]
  atribuicoes     EscalaAtribuicao[]

  /// Funções extras que quem exerce esta função também pode assumir na mesma
  /// missa, como último recurso (ex: Naveteiro pode assumir Sineta).
  podeAssumir Funcao[] @relation("FuncaoAcumulacao")
  /// Funções cujo ocupante pode assumir esta função como último recurso.
  assumidaPor Funcao[] @relation("FuncaoAcumulacao")

  paresComoA FuncaoPar[] @relation("FuncaoParA")
  paresComoB FuncaoPar[] @relation("FuncaoParB")

  paroquia Paroquia @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)
  pastoral Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@index([paroquiaId])
  @@index([pastoralId])
}

model Missa {
  id          String    @id @default(cuid())
  paroquiaId  String
  /// Recorrência semanal (0-6, domingo-sábado). Exclusivo com `dataUnica` —
  /// toda missa tem exatamente um dos dois preenchido.
  diaSemana   Int?
  /// Missa MENSAL: com diaSemana, vira "a N-ésima <diaSemana> do mês" (ex:
  /// 1ª sexta-feira). 1-4 = 1ª..4ª, 5 = última. Nulo = semanal toda semana.
  semanaDoMes Int?
  /// Data única (âncora UTC meia-noite, como MissaOcorrencia.data — ver
  /// lib/occurrences.ts): "missa grande" de evento único (ex: Natal, Nossa
  /// Senhora Aparecida), fora do ciclo semanal. Exclusivo com `diaSemana`.
  /// Não entra na lista de preferências da inscrição; com funções, as vagas
  /// são sorteadas entre todos os ativos ou só a comunidade responsável
  /// (ver MissaPastoral).
  dataUnica   DateTime?
  horario     String
  comunidade  String
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  funcoesRequisito       MissaFuncaoRequisito[]
  preferenciasServidores ServidorMissaPreferencia[]
  ocorrencias            MissaOcorrencia[]
  pastoraisConfig        MissaPastoral[]

  paroquia Paroquia @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)

  @@index([paroquiaId])
}

/// Como UMA pastoral serve numa missa compartilhada. Sem linha = o padrão
/// (escalarTodosAtivos false, sem comunidade responsável). Se a pastoral
/// serve ou não na missa é decidido pelas funções dela exigidas ali.
model MissaPastoral {
  id                    String  @id @default(cuid())
  missaId               String
  pastoralId            String
  /// Se true, a missa não usa o sistema normal de função/vaga para esta
  /// pastoral: ao clicar em "Escalar todos os ativos" na ocorrência, todo
  /// servidor ativo dela entra numa lista de presença simples, sem função
  /// individual (ver EscalaAtribuicao com funcaoId nulo). Na escala aparece
  /// "TODOS OS COROINHAS" (ou ministros).
  escalarTodosAtivos    Boolean @default(false)
  /// Missa de responsabilidade de uma comunidade: só servidores com
  /// Servidor.comunidade igual a este valor são sorteados para as funções,
  /// ignorando a preferência de missa (ver lib/scheduleGenerator.ts).
  comunidadeResponsavel String?

  missa    Missa    @relation(fields: [missaId], references: [id], onDelete: Cascade)
  pastoral Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@unique([missaId, pastoralId])
  @@index([pastoralId])
}

model MissaFuncaoRequisito {
  id         String  @id @default(cuid())
  missaId    String
  funcaoId   String
  quantidade Int     @default(1)
  ativo      Boolean @default(true)

  missa  Missa  @relation(fields: [missaId], references: [id], onDelete: Cascade)
  funcao Funcao @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  @@unique([missaId, funcaoId])
}

model Servidor {
  id             String    @id @default(cuid())
  paroquiaId     String
  pastoralId     String
  nome           String
  /// Âncora de dia civil (meia-noite UTC, mesma convenção de MissaOcorrencia.data
  /// — ver lib/occurrences.ts). Nullable: servidores migrados de `idade` (removida)
  /// ficam sem data até o admin preencher; ver lib/idade.ts para cálculo de idade.
  dataNascimento DateTime?
  /// URL pública do Storage (bucket "fotos-servidores") — ver lib/storage.ts.
  fotoUrl        String?
  comunidade     String
  /// Grau do servidor. Determina quais funções ele pode exercer (o dele e os abaixo).
  categoria      Grau
  /// Já serve há mais tempo: nas funções em dupla/par, o gerador junta um
  /// experiente com um inexperiente (ver FuncaoPar e lib/scheduleGenerator.ts).
  experiente     Boolean   @default(false)
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  preferenciasMissas ServidorMissaPreferencia[]
  atribuicoes        EscalaAtribuicao[]
  indisponibilidades ServidorIndisponibilidade[]

  vinculosComoA ServidorVinculo[] @relation("VinculoA")
  vinculosComoB ServidorVinculo[] @relation("VinculoB")

  paroquia Paroquia @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)
  pastoral Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@index([paroquiaId])
  @@index([pastoralId])
}

/// Dias em que o próprio servidor avisou (pela tela pública /indisponibilidade)
/// que não pode servir — o gerador de escala não o escala em nenhuma missa
/// nesse dia civil (âncora UTC meia-noite, como MissaOcorrencia.data).
model ServidorIndisponibilidade {
  id         String   @id @default(cuid())
  servidorId String
  data       DateTime
  createdAt  DateTime @default(now())

  servidor Servidor @relation(fields: [servidorId], references: [id], onDelete: Cascade)

  @@unique([servidorId, data])
}

/// Vínculo entre dois servidores (ex: irmãos que só servem quando o outro
/// também vai) — o gerador de escala só escala ambos juntos na mesma missa,
/// ou nenhum dos dois. Par não ordenado: A/B não tem significado além de
/// evitar duas linhas para o mesmo par.
/// Duas funções diferentes que trabalham juntas na missa (ex: Turiferário e
/// Naveteiro): o gerador trata as duas vagas como um par e tenta juntar um
/// servidor experiente com um inexperiente. Par não ordenado (A < B).
model FuncaoPar {
  id         String @id @default(cuid())
  pastoralId String
  funcaoAId  String
  funcaoBId  String

  funcaoA  Funcao   @relation("FuncaoParA", fields: [funcaoAId], references: [id], onDelete: Cascade)
  funcaoB  Funcao   @relation("FuncaoParB", fields: [funcaoBId], references: [id], onDelete: Cascade)
  pastoral Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@unique([funcaoAId, funcaoBId])
  @@index([pastoralId])
}

model ServidorVinculo {
  id          String @id @default(cuid())
  servidorAId String
  servidorBId String

  servidorA Servidor @relation("VinculoA", fields: [servidorAId], references: [id], onDelete: Cascade)
  servidorB Servidor @relation("VinculoB", fields: [servidorBId], references: [id], onDelete: Cascade)

  @@unique([servidorAId, servidorBId])
}

model ServidorMissaPreferencia {
  id         String @id @default(cuid())
  servidorId String
  missaId    String

  servidor Servidor @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  missa    Missa    @relation(fields: [missaId], references: [id], onDelete: Cascade)

  @@unique([servidorId, missaId])
}

model MissaOcorrencia {
  id         String   @id @default(cuid())
  paroquiaId String
  missaId    String
  data       DateTime
  createdAt  DateTime @default(now())

  missa       Missa              @relation(fields: [missaId], references: [id], onDelete: Cascade)
  atribuicoes EscalaAtribuicao[]

  paroquia Paroquia @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)

  @@unique([missaId, data])
  @@index([paroquiaId, data])
}

/// Mês cuja escala foi liberada para os servidores na página pública
/// /escala. Existir a linha = publicado; despublicar apaga a linha. A escala
/// mostrada é sempre a atual do banco (ajustes depois de publicar aparecem).
model EscalaPublicada {
  id          String   @id @default(cuid())
  paroquiaId  String
  pastoralId  String
  /// Mês no formato "yyyy-MM" (ex: "2026-09").
  mes         String
  publicadaEm DateTime @default(now())

  paroquia Paroquia @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)
  pastoral Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@unique([pastoralId, mes])
}

model Escala {
  id            String   @id @default(cuid())
  paroquiaId    String
  pastoralId    String
  periodoInicio DateTime
  periodoFim    DateTime
  geradaEm      DateTime @default(now())

  atribuicoes EscalaAtribuicao[]

  paroquia Paroquia @relation(fields: [paroquiaId], references: [id], onDelete: Cascade)
  pastoral Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@index([paroquiaId])
  @@index([pastoralId])
}

model EscalaAtribuicao {
  id                    String   @id @default(cuid())
  /// Pastoral dona da vaga: a ocorrência é compartilhada, mas cada pastoral
  /// gera, edita e apaga só as próprias atribuições.
  pastoralId            String
  escalaId              String?
  ocorrenciaId          String
  /// Nulo só na lista de presença simples de missas `escalarTodosAtivos`
  /// (ver Missa) — aí não existe função individual, só presença.
  funcaoId              String?
  slotIndex             Int      @default(1)
  servidorId            String?
  servidorNomeSnapshot  String?
  geradoAutomaticamente Boolean  @default(true)
  /// Presença registrada pelo administrador depois da missa: null = ainda não
  /// registrada, true = compareceu, false = faltou. Alimenta o cálculo de
  /// frequência que rebaixa a prioridade de quem falta muito (ver lib/frequencia.ts).
  presente              Boolean?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  escala     Escala?         @relation(fields: [escalaId], references: [id], onDelete: SetNull)
  ocorrencia MissaOcorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  funcao     Funcao?         @relation(fields: [funcaoId], references: [id], onDelete: Cascade)
  servidor   Servidor?       @relation(fields: [servidorId], references: [id], onDelete: SetNull)
  pastoral   Pastoral        @relation(fields: [pastoralId], references: [id], onDelete: Cascade)

  @@unique([ocorrenciaId, funcaoId, slotIndex])
  @@index([pastoralId])
}
